# matrix-tldr Konfiguration. Kopieren nach .env und Werte eintragen. Die .env gehört NIE ins Git.

# --- Matrix ---------------------------------------------------------------------------------
# Adresse deines Homeservers (Client-API), z. B. https://matrix.example.org
MATRIX_HOMESERVER=https://matrix.example.org
# Vollständige Matrix-ID des Bot-Kontos, z. B. @tldr:example.org
MATRIX_USER_ID=@tldr:example.org
# Passwort des Bot-Kontos. Nur für den allerersten Login nötig; danach genügt die gespeicherte
# Session im Store und die Variable kann leer bleiben bzw. entfernt werden.
MATRIX_PASSWORD=
# Anzeigename des Bot-Geräts in der Geräteliste (Element)
MATRIX_DEVICE_NAME=matrix-tldr
# Verzeichnis für Crypto-Store und Session. Im Docker-Container wird /app/store (Volume) erzwungen.
MATRIX_STORE_PATH=./store

# --- KI -------------------------------------------------------------------------------------
# Provider: anthropic (Claude) oder openai (auch OpenAI-kompatible Server über OPENAI_BASE_URL)
AI_PROVIDER=anthropic
# Modellname des gewählten Providers. Empfehlung: claude-haiku-5-5 (günstig, für zwei Sätze
# völlig ausreichend). Stärkere Alternative: claude-sonnet-5-5.
AI_MODEL=claude-haiku-5-5
# Denkaufwand bei Claude-Modellen: low, medium, high, xhigh, max oder none (Parameter nicht
# senden, nötig für Modelle ohne Effort-Unterstützung). Für Zusammenfassungen reicht low.
AI_EFFORT=low
# API-Key für Anthropic (nötig bei AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# API-Key für OpenAI bzw. einen kompatiblen Endpunkt (nötig bei AI_PROVIDER=openai)
OPENAI_API_KEY=
# Optional: Basis-URL eines OpenAI-kompatiblen Endpunkts (selbst gehostet, EU-Anbieter), z. B.
# https://llm.example.org/v1
OPENAI_BASE_URL=
# Maximale Zeichenzahl des Webseitentexts, die an die KI gesendet wird
AI_MAX_INPUT_CHARS=12000
# Timeout pro KI-Anfrage in Sekunden
AI_TIMEOUT_SECONDS=30

# --- Abruf ----------------------------------------------------------------------------------
# Timeout für den Abruf einer Webseite in Sekunden (Gesamtfrist ist das Dreifache)
FETCH_TIMEOUT_SECONDS=10
# Maximale Größe einer Webseite in Bytes (5 MiB); größere Seiten werden abgelehnt
FETCH_MAX_BYTES=5242880

# --- Verhalten ------------------------------------------------------------------------------
# Wie viele Links pro Nachricht zusammengefasst werden
MAX_LINKS_PER_MESSAGE=1
# Maximale Zusammenfassungen pro Raum und Minute (Schutz vor KI-Kosten); darüber nur Log-Eintrag
RATE_LIMIT_PER_ROOM_PER_MINUTE=5
# Optional: kommagetrennte Raum-IDs (!abc:server, in Element unter Raumeinstellungen, Erweitert);
# Aliase (#raum:server) sind absichtlich NICHT erlaubt, da Raum-Admins sie frei setzen können.
# Leer = alle Räume.
ALLOWED_ROOMS=
# Optional: kommagetrennte Matrix-IDs, deren Einladungen angenommen werden; leer = jede Einladung
AUTO_JOIN_ALLOWED_INVITERS=
# Nur für die Geräteverifizierung: true bestätigt die Emojis auf Bot-Seite automatisch. Vergleich
# und Bestätigung in Element bleiben bei dir. Danach wieder auf false stellen (siehe README).
VERIFY_AUTO_CONFIRM=false
# Log-Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
